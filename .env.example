# Optional WhatsApp number for pre-filled customer enquiries. Digits only with country code.
# Example format (NOT a real number): 919999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Private Neon PostgreSQL connection string from the Connect dialog.
# Use the pooled endpoint with TLS for the app. Never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=

# Private operator access for the post-booking travel feature. Use a random secret (24+ characters).
# Never prefix this value with NEXT_PUBLIC_. Restart the server after changing it.
TRAVEL_ADMIN_KEY=
